    {
      "id": "sa05-tools",
      "order": 305,
      "section": "single-agent",
      "status": "planned",
      "title": {
        "zh-CN": "Tool-Using Agent as an Architecture Boundary"
      },
      "description": {
        "zh-CN": "模型能提出行动意图，但不能成为执行权限本身。若工具只是任意函数入口，Prompt 注入和参数错误会直接变成外部副作用。"
      },
      "url": "zh/02-single-agent/sa05-tools/",
