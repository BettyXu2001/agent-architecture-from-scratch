    {
      "id": "sa01-react",
      "order": 301,
      "section": "single-agent",
      "status": "planned",
      "title": {
        "zh-CN": "ReAct Architecture"
      },
      "description": {
        "zh-CN": "开放任务的下一步依赖工具返回，无法在运行前写成完整路径。ReAct 让模型在行动与观察之间迭代更新决策。"
