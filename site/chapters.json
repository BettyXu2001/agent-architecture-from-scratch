    {
      "id": "sa06-termination",
      "order": 306,
      "section": "single-agent",
      "status": "planned",
      "title": {
        "zh-CN": "Termination、Clarification 与 Budget"
      },
      "description": {
        "zh-CN": "Agent 不知道何时停，就会过早回答、反复搜索或在信息不足时猜测。停止是一等架构能力，不是 Prompt 末尾一句话。"
      },
